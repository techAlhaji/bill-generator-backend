# ==============================================================================
# Stellar Bill Generator — Backend Production / Testnet Environment Variables
# ==============================================================================
# NOTE: This file is a safe, secret-free template for production operations.
# Populate all secret placeholders via your secure secrets manager (AWS Secrets Manager,
# HashiCorp Vault, Kubernetes Secrets, or Doppler) during deployment.

# Node.js Server Runtime
PORT=4000
NODE_ENV="production"

# Primary Frontend Application Origin
FRONTEND_URL="https://stellar-bills.example.com"

# Optional Additional CORS Origins (comma-separated, e.g. for preview deployments)
CORS_ORIGIN="https://stellar-bills.example.com,https://preview.stellar-bills.example.com"

# PostgreSQL Database Connection URL (ACID Transactional Storage)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]?schema=public&sslmode=require
DATABASE_URL="postgresql://db_user:YOUR_SECURE_PASSWORD@db.production.internal:5432/bill_generator?schema=public&sslmode=require"

# JWT Authentication Secret (Must be high-entropy, minimum 32 characters)
JWT_SECRET="YOUR_HIGH_ENTROPY_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS"
JWT_EXPIRES_IN="7d"

# Rate Limiting Configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# Stellar Ecosystem & Network Target ("TESTNET" only for this phase)
STELLAR_NETWORK="TESTNET"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL="https://horizon-testnet.stellar.org"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Deployed Soroban Invoice Registry Contract ID (Testnet Release)
INVOICE_REGISTRY_CONTRACT_ID="CCG6V5QEJZ2QI7EXIRVQXCHUIFUROXUBMZPTSCRJHOO35CAQ2HZ6IJGC"

# Server Stellar Signer Secret Key for SEP-10 Web Authentication Challenges (S...)
# Required only if SEP-10 challenge generation is enabled. Keep strictly confidential.
SERVER_SIGNER_SECRET_KEY="SAYOUR_CONFIDENTIAL_SERVER_SIGNER_STELLAR_SECRET_KEY"

# Asset Allowlist (Comma-separated asset codes, classic pairs, or token IDs; or "*" to allow all)
# Example: XLM,USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ASSET_ALLOWLIST="XLM,USDC"
